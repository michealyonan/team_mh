<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only: no cleartext traffic anywhere, trust only system CAs
         (user-installed CAs cannot intercept the app's traffic). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
