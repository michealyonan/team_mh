{
  "name": "team-mh-desktop",
  "version": "0.3.11",
  "description": "team_mh desktop app (Windows)",
  "main": "main.js",
  "author": "team_mh",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "electron-updater": "^6.3.9",
    "puppeteer-core": "^23.11.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.michealyonan.teammh",
    "productName": "team_mh",
    "files": [
      "main.js",
      "chromeproc.js",
      "chromewalk.js",
      "preload.js",
      "commands.html",
      "icon.png",
      "package.json",
      "node_modules/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "team_mh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "michealyonan",
        "repo": "team_mh",
        "releaseType": "release"
      }
    ]
  }
}